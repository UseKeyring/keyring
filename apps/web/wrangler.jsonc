{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "keyring",
  // Generated by `opennextjs-cloudflare build` — never edit .open-next/ by hand.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep workers.dev + previews on: the custom domain adds an address,
  // it doesn't replace the existing ones.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Custom domain (zone already on Cloudflare — DNS + cert auto-provision).
  "routes": [{ "pattern": "usekeyring.dev", "custom_domain": true }],
  // Runtime vars for /api/agent (non-sensitive; the key itself is a secret).
  "vars": {
    "AGENT_AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "AGENT_AI_MODEL": "gemini-3.6-flash"
  },
  // No `vars`: the app only needs NEXT_PUBLIC_* build-time vars (inlined by
  // `next build`). All secrets live in Supabase edge functions, not here.
}
