# Public Supabase client (browser)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Private beta gate: set to "true" to replace the landing page with a
# waitlist signup and restrict the app to approved emails. Visitors join at
# / (POST /api/waitlist); enroll them with:
#   UPDATE public.waitlist_emails SET status='approved', approved_at=now()
#   WHERE lower(email)=lower('friend@example.com');
# Approved emails can sign in and use the app while the gate is on.
# NEXT_PUBLIC_WAITLIST=true works on Vercel (client-visible);
# WAITLIST=true is the server-only equivalent. Apply
# drizzle/migrations/0026_waitlist.sql in the Supabase SQL editor first.
# NEXT_PUBLIC_WAITLIST=""
# Server-side (middleware / server components + management API).
# The publishable key is enough for everything: API routes authenticate
# issued keys inside SECURITY DEFINER functions. No service_role key is
# used anywhere in the Next.js stack — do not add one.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Billing edge functions only (supabase secrets set --project-ref <ref>).
# Never prefix these with NEXT_PUBLIC_ — POLAR_ACCESS_TOKEN and
# SUPABASE_SERVICE_ROLE_KEY must stay server-side inside edge functions.
# POLAR_ACCESS_TOKEN=""
# POLAR_ENV="sandbox"            # sandbox | production
# POLAR_PRO_PRODUCT_ID=""
# POLAR_WEBHOOK_SECRET=""
# APP_URL="http://localhost:3000"
